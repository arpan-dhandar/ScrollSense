# Backend environment variables
# Copy this file to .env and fill in the values.
# NEVER commit .env — only .env.example is safe to commit.

# ── App ────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── CORS ───────────────────────────────────────
# Comma-separated origins allowed by CORS (your Vite dev server)
CLIENT_ORIGIN=http://localhost:5173

# ── MongoDB (required when user features are enabled) ──
# MONGODB_URI=mongodb://localhost:27017/scrollsense

# ── Auth (required when auth is enabled) ───────
# JWT_SECRET=CHANGE_ME_generate_a_64_char_random_string
# SESSION_SECRET=CHANGE_ME_generate_a_64_char_random_string

# ── AI Provider (required when AI coach is enabled) ──
# GEMINI_API_KEY=
